// dbd-sqlite - SQLite driver backend adapter for the DBI interface
// Author: YTNOBODY
// License: MIT
//
// This module builds a driver ADAPTER conforming to the `calcium-dbi` adapter
// contract. It lauches the `dbd-sqlite` backend process (a separate Go binary
// that embeds SQLite via modernc.org/sqlite) and talks to it over the DBI
// text-stream protocol (line-delimited JSON on stdio) using core.os.proc_*.
//
// Usage:
//   use dbi;          // calcium-dbi (pure-Calcium DBI interface)
//   use dbd.sqlite;   // this driver backend adapter (dbd.sqlite -> sqlite.*)
//   adapter = sqlite.adapter({backend: "dbd-sqlite"});
//   dbh = dbi.connect(adapter, "app.db", {}) !? { ... };

namespace sqlite;

use core.os!;
use core.json!;
use core.string;
use core.types;

// ---------------------------------------------------------------------------
// Error types
//
// SQLite/driver failures are returned as a DbError value (not a bare string),
// so error kinds can be checked with constraints:
//
//   r !? { success(v) => ...  failure(e) => e |> sqlite.ConnectionError? }
//
// Each variant is also exposed via a matching `sqlite.<Name>` constraint.
// ---------------------------------------------------------------------------

type DbError =
    ConnectionErr(msg) |
    ConstraintErr(msg) |
    SyntaxErr(msg) |
    NotFoundErr(msg) |
    TypeErr(msg) |
    IOErr(msg) |
    BusyErr(msg) |
    ProtocolErr(msg) |
    UnknownErr(msg);

constraint ConnectionError(e) = _is_variant(e, "connection");
constraint ConstraintError(e) = _is_variant(e, "constraint");
constraint SyntaxError(e) = _is_variant(e, "syntax");
constraint NotFoundError(e) = _is_variant(e, "not_found");
constraint TypeError(e) = _is_variant(e, "type");
constraint IOError(e) = _is_variant(e, "io");
constraint BusyError(e) = _is_variant(e, "busy");
constraint ProtocolError(e) = _is_variant(e, "protocol");
constraint UnknownError(e) = _is_variant(e, "unknown");

func _is_variant(e, kind) = match e
    ConnectionErr(m) => kind == "connection"
    ConstraintErr(m) => kind == "constraint"
    SyntaxErr(m) => kind == "syntax"
    NotFoundErr(m) => kind == "not_found"
    TypeErr(m) => kind == "type"
    IOErr(m) => kind == "io"
    BusyErr(m) => kind == "busy"
    ProtocolErr(m) => kind == "protocol"
    UnknownErr(m) => kind == "unknown";

// Map a protocol error code to the corresponding DbError variant.
func _err(code, msg) = match code
    "connection" => ConnectionErr(msg)
    "constraint" => ConstraintErr(msg)
    "syntax" => SyntaxErr(msg)
    "not_found" => NotFoundErr(msg)
    "type" => TypeErr(msg)
    "io" => IOErr(msg)
    "busy" => BusyErr(msg)
    "protocol" => ProtocolErr(msg)
    true => UnknownErr(msg);

// ---------------------------------------------------------------
// Public: build the DBI adapter hash for SQLite.
// options.backend overrides the backend executable (default "dbd-sqlite");
// options.dsn_prefix is prepended to the dsn passed to the backend.
// ---------------------------------------------------------------
func adapter(options) = {
    name: "sqlite",
    connect: _connect,
    disconnect: _disconnect,
    execute: _execute,
    query: _query,
    query_meta: _query_meta,
    query_row: _query_row,
    prepare: _prepare,
    execute_prepared: _execute_prepared,
    query_prepared: _query_prepared,
    finish: _finish
};

func _backend_name(options) = match has(options, "backend")
    true => options.backend
    false => "dbd-sqlite";

// ---------------------------------------------------------------
// RPC: send a request hash to the backend and read its response.
// ---------------------------------------------------------------

func _rpc(proc, req) = _rpc_encoded(proc, req, json.stringify(req));

func _rpc_encoded(proc, req, encoded) = encoded !? {
    success(s) => _rpc_send(proc, s)
    failure(e) => failure(ProtocolErr(e))
};

func _rpc_send(proc, s) = os.proc_write(proc, concat(s, "\n")) !? {
    success(_) => _rpc_read(proc)
    failure(e) => failure(ProtocolErr(e))
};

func _rpc_read(proc) = os.proc_read_line(proc) !? {
    success(line) => _rpc_parse(proc, line)
    failure(e) => failure(ProtocolErr(e))
};

func _rpc_parse(proc, line) = json.parse(line) !? {
    success(v) => _rpc_result(v)
    failure(e) => failure(ProtocolErr(e))
};

func _rpc_result(v) = match v.ok
    true => success(v)
    false => failure(_err(v.code, v.error));

// ---------------------------------------------------------------
// DBI adapter contract implementation
// ---------------------------------------------------------------

func _connect(dsn, options) = _launch(_backend_name(options), dsn);

func _launch(backend, dsn) = os.proc_start(backend, [dsn]) !? {
    success(proc) => success({driver: "sqlite", proc: proc})
    failure(e) => failure(ConnectionErr(concat("could not start backend '", concat(backend, concat("': ", e)))))
};

func _disconnect(dbh) = os.proc_close(dbh.proc);

func _execute(dbh, sql, params) = _rpc(dbh.proc, {op: "execute", sql: sql, params: params}) !? {
    success(r) => success(r.rows_affected)
    failure(e) => failure(e)
};

func _query(dbh, sql, params) = _rpc(dbh.proc, {op: "query", sql: sql, params: params}) !? {
    success(r) => success(r.rows)
    failure(e) => failure(e)
};

// query_meta returns the full query result including schema metadata
// (columns + column_types), so the DBI layer / callers can derive constraints.
func _query_meta(dbh, sql, params) = _rpc(dbh.proc, {op: "query", sql: sql, params: params}) !? {
    success(r) => success({columns: r.columns, column_types: r.column_types, rows: r.rows})
    failure(e) => failure(e)
};

// query_row returns the first row, or success(null) when there is no row.
func _query_row(dbh, sql, params) = _rpc(dbh.proc, {op: "query_row", sql: sql, params: params}) !? {
    success(r) => success(r.row)
    failure(e) => failure(e)
};

// ---------------------------------------------------------------------------
// Constraint generation from schema metadata.
//
// SQLite queries report each result column's declared type; the adapter
// surfaces them as `column_types`. These functions turn that type information
// into per-column validator constraints. This mapping is SQLite-specific and
// therefore lives in this DBD (driver) rather than in the generic DBI layer.
// ---------------------------------------------------------------------------

// schema(meta) -> hash: column name -> {dbtype, type_of, is}
//   dbtype  : raw declared type (e.g. "INTEGER", or Go "int64" for expressions)
//   type_of : normalized affinity label (int/float/num/string/bool/unknown)
//   is      : validator function (value -> bool)
// meta comes from dbi.query_meta(dbh, sql, params). An unknown/untyped column
// falls back to the loosest concrete type (string).
func schema(meta) = _schema_build(meta.columns, meta.column_types, 0, {});

func _schema_build(cols, types, i, acc) = match i >= len(cols)
    true => acc
    false => match i >= len(types)
        true => _schema_build(cols, types, i + 1, _schema_put(acc, cols[i], ""))
        false => _schema_build(cols, types, i + 1, _schema_put(acc, cols[i], types[i]));

func _schema_put(acc, col, t) = hash_set(acc, col, {
    dbtype: t,
    type_of: _affinity(t),
    is: _is_of(_affinity(t))
});

func _is_of(a) = match a
    "int" => types.is_int
    "float" => types.is_float
    "num" => types.is_number
    "string" => types.is_string
    "bool" => types.is_bool
    true => types.is_string;

// Map a declared column type to a normalized affinity label. Handles both
// SQLite declared types (INTEGER, REAL, TEXT, BLOB, NUMERIC, BOOL) and the Go
// reflection names the driver reports for expressions / untyped columns
// (int64, float64, string, bool, []uint8). An empty / unrecognized type falls
// back to the loosest concrete type, string.
func _affinity(t) = match _has(t, "INT")
    true => "int"
    false => match _has(t, "FLOA") || _has(t, "DOUB") || _has(t, "REAL")
        true => "float"
        false => match _has(t, "BOOL")
            true => "bool"
            false => match _has(t, "NUM")
                true => "num"
                false => match _has(t, "CHAR") || _has(t, "TEXT") || _has(t, "CLOB") || _has(t, "STR")
                    true => "string"
                    false => match _has(t, "BLOB") || _has(t, "BIN") || _has(t, "BYT") || _has(t, "UINT")
                        true => "string"
                        false => "string";

func _has(s, sub) = _has_upper(string.upper(s), sub);
func _has_upper(us, sub) = string.contains(us, sub);

// validate(schema, row) -> success(true) | failure("column ... violation")
// Checks every column present in `row` against the schema validators.
func validate(schema, row) = _validate_keys(schema, row, keys(row));

func _validate_keys(schema, row, ks) = match len(ks)
    0 => success(true)
    true => _validate_key(schema, row, head(ks), tail(ks));

func _validate_key(schema, row, col, rest) = _check(schema, row, col) !? {
    success(_) => _validate_keys(schema, row, rest)
    failure(e) => failure(e)
};

func _check(schema, row, col) = match !has(schema, col)
    true => success(true)
    false => _check_val(get(schema, col), get(row, col));

func _check_val(c, val) = match c.is(val)
    true => success(true)
    false => failure(concat("column '", concat(to_string(c.dbtype), concat("' type violation for value ", to_string(val)))));

func _prepare(dbh, sql) = _rpc(dbh.proc, {op: "prepare", sql: sql}) !? {
    success(r) => success({proc: dbh.proc, stmt: r.stmt})
    failure(e) => failure(e)
};

func _execute_prepared(stmt, params) = _rpc(stmt.proc, {op: "execute_prepared", stmt: stmt.stmt, params: params}) !? {
    success(r) => success(r.rows_affected)
    failure(e) => failure(e)
};

func _query_prepared(stmt, params) = _rpc(stmt.proc, {op: "query_prepared", stmt: stmt.stmt, params: params}) !? {
    success(r) => success(r.rows)
    failure(e) => failure(e)
};

func _finish(stmt) = _rpc(stmt.proc, {op: "finish", stmt: stmt.stmt}) !? {
    success(_) => success(true)
    failure(e) => failure(e)
};

